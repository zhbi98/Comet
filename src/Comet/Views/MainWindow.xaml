<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Comet.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Comet.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Comet"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="WindowRoot"
        Background="{StaticResource CometPageBrush}"
        RequestedTheme="Light">
        <Grid.Resources>
            <x:Double x:Key="TitleBarIconMaxWidth">20</x:Double>
            <x:Double x:Key="TitleBarIconMaxHeight">20</x:Double>
            <Style x:Key="MainMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
                <!--  The title content is raised slightly, so the flyout needs its own gap below the title bar.  -->
                <Setter Property="MinWidth" Value="196" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Window identity and application menu.  -->
        <TitleBar x:Name="AppTitleBar" Height="36">
            <TitleBar.LeftHeader>
                <StackPanel
                    Margin="0,-3,0,3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Image
                        x:Name="TitleBarIconImage"
                        Width="20"
                        Height="20"
                        Margin="5,0,2,0"
                        VerticalAlignment="Center"
                        Stretch="Uniform" />

                    <Button
                        x:Name="MainMenuButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="主菜单"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        ToolTipService.ToolTip="菜单">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Glyph="&#xE700;" />
                        <Button.Flyout>
                            <MenuFlyout
                                MenuFlyoutPresenterStyle="{StaticResource MainMenuFlyoutPresenterStyle}"
                                Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    x:Name="TerminalFontSettingsMenuItem"
                                    Click="TerminalFontSettingsMenuItem_Click"
                                    Text="终端字体设置…" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="ImportCommandPresetsMenuItem"
                                    Click="ImportCommandPresetsMenuItem_Click"
                                    Text="导入快捷指令…" />
                                <MenuFlyoutItem
                                    x:Name="ExportCommandPresetsMenuItem"
                                    Click="ExportCommandPresetsMenuItem_Click"
                                    Text="导出快捷指令…" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Comet" />
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <!--  Terminal typography editor. Its values are owned by TerminalAppearanceViewModel.  -->
        <ContentDialog
            x:Name="TerminalFontSettingsDialog"
            Title="终端字体设置"
            Grid.RowSpan="2"
            CloseButtonText="完成">
            <Grid Width="360" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="内容区显示" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="更改会即时应用，不会影响已经接收的数据或当前选择。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="TerminalFontFamilyComboBox"
                        HorizontalAlignment="Stretch"
                        Header="字体"
                        SelectionChanged="TerminalFontFamilyComboBox_SelectionChanged" />

                    <NumberBox
                        x:Name="TerminalFontSizeNumberBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="字号"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="TerminalFontSizeNumberBox_ValueChanged" />
                </Grid>

                <StackPanel Grid.Row="2" Spacing="7">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="预览" />
                        <TextBlock
                            x:Name="TerminalFontPreviewSummaryTextBlock"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Border
                        MinHeight="94"
                        Padding="14,12"
                        Background="{StaticResource CometTerminalBrush}"
                        BorderBrush="{StaticResource CometTerminalBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="TerminalFontPreviewTextBlock"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource CometTerminalTextBrush}"
                            Text="Comet Terminal&#x0a;&gt; Aa Bb 0123456789&#x0a;&gt; 串口通信 READY"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <Button
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    Click="ResetTerminalFontButton_Click"
                    Content="恢复默认设置" />
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
