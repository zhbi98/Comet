<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Comet.Controls.VirtualTerminalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    Loaded="VirtualTerminalControl_Loaded"
    SizeChanged="VirtualTerminalControl_SizeChanged">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="LineViewport"
            Background="Transparent"
            ManipulationDelta="LineViewport_ManipulationDelta"
            ManipulationMode="TranslateY,TranslateInertia">
            <Canvas x:Name="LineSurface" />

            <TextBox
                x:Name="InputProxy"
                Width="1"
                Height="1"
                MinWidth="0"
                MinHeight="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AcceptsReturn="True"
                Opacity="0"
                TextChanged="InputProxy_TextChanged" />
        </Grid>

        <ScrollBar
            x:Name="VerticalScrollBar"
            Grid.Column="1"
            HorizontalAlignment="Right"
            IndicatorMode="MouseIndicator"
            Orientation="Vertical"
            ValueChanged="VerticalScrollBar_ValueChanged" />
    </Grid>
</UserControl>
